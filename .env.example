# Copy to .env and change every CHANGE_ME value. Never commit .env.
POSTGRES_PASSWORD=CHANGE_ME_local_db_password
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ABP_JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
ABP_ENV=development
ABP_COOKIE_SECURE=false
ABP_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
ABP_LOG_JSON=true
# Password for the demo users created by `python -m app.cli demo` (min 12 chars).
ABP_DEMO_PASSWORD=CHANGE_ME_demo_password

# --- AI provider ---
# "auto": Claude when ANTHROPIC_API_KEY is set, otherwise offline mode (no LLM).
ABP_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...        # enables Claude; request texts (e-mails, invoices) are then sent to Anthropic
ABP_CLAUDE_MODEL=claude-opus-5-5
ABP_CLAUDE_EFFORT=low
# Simulated tool outages for demos (0 = off, 0.3 = 30% of tool calls fail transiently)
ABP_CHAOS_FAILURE_RATE=0

